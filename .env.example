# AI Router (api.airouter.in) — required for cloud Mind calls.
#
# 1. Copy this file to `.env` (same folder). `.env` is gitignored.
# 2. Paste your key after the `=`, no quotes, no spaces.
# 3. Restart Yuri. `python orchestrator/check.py` in the repo root will tell you
#    whether it resolved and whether the model catalog loaded.
#
# Without this key Yuri still runs: every role stays local (the `mind` role
# silently falls back to qwen3.5:9b). Nothing else needs a network key.
AIROUTER_API_KEY=

# Optional overrides (rarely needed)
# AIROUTER_BASE_URL=https://api.airouter.in/v1
